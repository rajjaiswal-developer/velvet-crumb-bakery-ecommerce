# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Razorpay Payment Gateway (Test Mode / Live Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx

# Brevo (Sendinblue) REST Email API Key & Verified Sender (Transactional Receipts)
BREVO_API_KEY=xkeysib-xxxxxx
BREVO_SENDER_EMAIL=your_verified_brevo_sender_email_here
BREVO_SENDER_NAME=Velvet Crumb Bakery

# Google Maps Geocoding API Key (5 km Delivery Radius Validation)
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxx

# ImageKit Media Storage
IMAGEKIT_PUBLIC_KEY=public_xxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/xxxxxx

# Admin Auth & Session Management (HS256 JWT Secret)
ADMIN_SESSION_SECRET=your_32_byte_random_admin_jwt_secret_here

# GitHub Actions Cron Shared Secret Header (Protected Cron Endpoints)
CRON_SECRET=your_32_byte_random_cron_secret_here

# Order Active Session JWT Secret (Dedicated Customer Order Status Banner Secret)
ORDER_SESSION_SECRET=your_32_byte_random_order_session_jwt_secret_here

# Cart Session JWT Secret
CART_SESSION_SECRET=your_32_byte_random_cart_session_jwt_secret_here

# Application Base URL (Domain / Vercel Staging URL)
NEXT_PUBLIC_APP_URL=https://velvetcrumbdemo.com
